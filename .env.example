# Environment Variables – Campus Lost & Found
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will NOT be committed.
# ─────────────────────────────────────────────────────────────────

# MongoDB connection string (required for database integration)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campus-lost-and-found?retryWrites=true&w=majority

# Next.js public URL (optional, for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

