# MongoDB Atlas Connection String (keep secrets in .env.local, never commit passwords)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campus-lost-and-found?retryWrites=true&w=majority

# JWT Authentication Secret (use a long random secret in production)
JWT_SECRET=replace_with_a_long_random_secret_string

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (Optional in dev; required for Cloudinary public item photo hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
